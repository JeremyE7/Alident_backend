# Database Configuration
# For SQLite (default)
DATABASE_URL="file:./dev.db"

# For PostgreSQL (uncomment to use)
# DATABASE_URL="postgresql://user:password@localhost:5432/alident?schema=public"

# For MySQL (uncomment to use)
# DATABASE_URL="mysql://user:password@localhost:3306/alident"

# For MongoDB (uncomment to use)
# DATABASE_URL="mongodb://localhost:27017/alident"

# Application Configuration
NODE_ENV=development
PORT=3000

# JWT Configuration (if needed in the future)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=3600

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
